{
 "datasets": [
  {
   "name": "ds_recent",
   "displayName": "Last 4 full weeks",
   "queryLines": [
    "SELECT store_id, product_name, category, units_sold, days_in_stock, period_days, stockout_days, waste_units, waste_value\n",
    "FROM workspace.grocery_intel.gold_store_product_week WHERE week_num > (SELECT max(week_num) FROM workspace.grocery_intel.gold_store_product_week WHERE NOT is_partial_week) - 4\n",
    "  AND NOT is_partial_week\n"
   ]
  },
  {
   "name": "ds_stockouts",
   "displayName": "Top stockout items (last 4 weeks)",
   "queryLines": [
    "SELECT store_id, product_name, category, sum(stockout_days) AS stockout_days,\n",
    "  round(sum(days_in_stock) / sum(period_days), 3) AS availability,\n",
    "  round(sum(est_demand) - sum(units_sold)) AS lost_units\n",
    "FROM workspace.grocery_intel.gold_store_product_week WHERE week_num > (SELECT max(week_num) FROM workspace.grocery_intel.gold_store_product_week WHERE NOT is_partial_week) - 4\n",
    "  AND NOT is_partial_week\n",
    "GROUP BY ALL HAVING sum(stockout_days) > 0 ORDER BY stockout_days DESC\n"
   ]
  },
  {
   "name": "ds_waste",
   "displayName": "Top waste items (last 4 weeks)",
   "queryLines": [
    "SELECT store_id, product_name, category, sum(waste_units) AS waste_units, round(sum(waste_value), 2) AS waste_usd,\n",
    "  round(sum(waste_units) / nullif(sum(received), 0), 3) AS waste_share_of_received\n",
    "FROM workspace.grocery_intel.gold_store_product_week WHERE week_num > (SELECT max(week_num) FROM workspace.grocery_intel.gold_store_product_week WHERE NOT is_partial_week) - 4\n",
    "  AND NOT is_partial_week\n",
    "GROUP BY ALL HAVING sum(waste_units) > 0 ORDER BY waste_usd DESC\n"
   ]
  },
  {
   "name": "ds_reorder",
   "displayName": "Next week's reorder list",
   "queryLines": [
    "SELECT store_id, product_name, category, round(forecast_units) AS forecast, on_hand, on_order, case_pack,\n",
    "  order_cases, order_units, order_value, reason\n",
    "FROM workspace.grocery_intel.gold_reorder_recommendation WHERE order_units > 0 ORDER BY store_id, order_value DESC\n"
   ]
  },
  {
   "name": "ds_trend",
   "displayName": "Weekly trend",
   "queryLines": [
    "SELECT store_id, week_start, sum(days_in_stock) AS days_in_stock, sum(period_days) AS period_days,\n",
    "  sum(waste_value) AS waste_value, sum(revenue) AS revenue\n",
    "FROM workspace.grocery_intel.gold_store_product_week WHERE NOT is_partial_week GROUP BY ALL\n"
   ]
  },
  {
   "name": "ds_briefs",
   "displayName": "AI weekly brief per store",
   "queryLines": [
    "SELECT store_id, store_name, brief, array_join(source_documents, ', ') AS sources FROM workspace.grocery_intel.gold_store_briefs\n"
   ]
  },
  {
   "name": "ds_model_error",
   "displayName": "Forecast error by method (backtest)",
   "queryLines": [
    "SELECT slice, method, wape FROM workspace.grocery_intel.gold_backtest_summary WHERE slice IN ('TOTAL', 'Promo weeks', 'Non-promo weeks')\n"
   ]
  },
  {
   "name": "ds_model_monitor",
   "displayName": "Model health",
   "queryLines": [
    "SELECT check_name, value, threshold, alert, champion_method, model_version, retrain_needed FROM workspace.grocery_intel.gold_model_monitor\n"
   ]
  },
  {
   "name": "ds_sources",
   "displayName": "Rows per source system",
   "queryLines": [
    "SELECT 'postgres_pos' AS source_system, 'pos_sales_weekly' AS source_table, count(*) AS bronze_rows FROM workspace.grocery_intel.bronze_pos_sales_weekly\n",
    "UNION ALL SELECT 'postgres_pos', 'pos_stock_snapshots', count(*) FROM workspace.grocery_intel.bronze_pos_stock_snapshots\n",
    "UNION ALL SELECT 'mysql_erp', 'erp_products', count(*) FROM workspace.grocery_intel.bronze_erp_products\n",
    "UNION ALL SELECT 'saas_store_ops', 'ops_waste_log', count(*) FROM workspace.grocery_intel.bronze_ops_waste_log\n",
    "UNION ALL SELECT 'saas_promo_tool', 'promo_calendar', count(*) FROM workspace.grocery_intel.bronze_promo_calendar\n"
   ]
  }
 ],
